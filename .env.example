# Copy this file to .env and uncomment what you need. The app reads .env when it starts.
# Variables already set in the environment win over this file.
# .env is git-ignored. Keep secrets in it only on your own machine.

# Mock mode. Each part can be mocked on its own; MOCK_MODE=1 mocks all three.
# MOCK_AZURE=1      # Discover returns a saved copy of hackaton-2026-rg, without az
# MOCK_AI=1         # canned AI answers: no tokens are spent
# MOCK_LEASEWEB=1   # a mock key and a fake Leaseweb API: nothing is sent to Leaseweb
# MOCK_MODE=1       # all three
# Pauses that make the loading states visible in mock mode (1 = normal, 0 = none).
# MOCK_DELAY=1

# AI provider: claude-cli, anthropic-api or opencode. It can also be changed in the app.
# AI_PROVIDER=claude-cli
# AI_MODEL=
# ANTHROPIC_API_KEY=

# Extra host names the app may be opened by (comma-separated). localhost and IP addresses always work.
# ALLOWED_HOSTS=devbox.lan
